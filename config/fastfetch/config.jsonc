{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "$(ls ~/.config/fastfetch/pngs/*.png | shuf -n 1)",
        "width": 30
    },
    "display": {
        "separator": "",
        "color": "cyan"
    },
    "modules": [
        {
            "type": "command",
            "key": " ​ ​",
            "keyWidth": 0,
            "text": "echo $(sed -n \"$((RANDOM % $(wc -l < \"${XDG_CONFIG_HOME:-$HOME/.config}/neofetch/quotes/1.txt\") + 1))p\" \"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/quotes/1.txt\")"

            //"type": "custom",
            //"format": " ​​ ​​All that awaits the weak is death - Griffith",
        },
        "break",
        {
            "type": "os",
            "key": "󰣇 ​ ​OS: ",
            "keyColor": "red"
        },
        {
            "type": "kernel",
            "key": " ​ ​Kernel: ",
            "format": "{1} {2}",
            "keyColor": "red"
        },
        {
            "type": "uptime",
            "key": "󰟡  ​Uptime: ",
            "keyColor": "green"
        },
        "break",
        {
            "type": "title",
            "key": " : "
        },
        "break",
        {
            "type": "board",
            "key": " ​ MOTHER: ",
            "keyColor": "cyan"
        },
        {
            "type": "cpu",
            "key": "󰻠 ​ ​CPU: ",
            "keyColor": "cyan"
        },
        {
            "type": "gpu",
            "detectionMethod": "pci",
            "format": "{2} ({3})",
            "key": "󰢮 ​ GPU: ",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "󰍛 ​ ​Memory: ",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "colors",
            "symbol": "star",
            "block": {
                "width": 3
            } 
        },
        /*
	{
            "type": "command",
            "key": "OS Age",
            "keyColor": "magenta",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
	*/
    ]
}
